{
  "name": "persona-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Persona - AI-powered life management system",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "pnpm install",
    "build:all": "pnpm -r run build",
    "lint:all": "pnpm -r run lint",
    "format:all": "pnpm -r run format"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.4.7",
      "qs": "^6.14.2",
      "minimatch": "^10.2.1",
      "lodash": "^4.17.23",
      "axios": "^1.7.9",
      "bn.js": "^5.2.1",
      "esbuild": "^0.25.0",
      "@remix-run/router": "^1.21.0",
      "@types/react": "^18.3.0",
      "@types/react-dom": "^18.3.0"
    }
  }
}
